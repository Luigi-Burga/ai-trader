"""
AI Trader - Shared Market Data Layer V2
=======================================

Purpose
-------
Centralize yfinance access and reuse market-data responses across engines.

V2 goals:
- One shared cache for the whole Python process and across scheduler runs.
- Preserve each caller's existing yfinance semantics (period, interval,
  auto_adjust, actions, group_by).
- Prevent duplicate Yahoo requests for identical data requests.
- Atomic cache writes and defensive cache reads.
- No trading or signal logic is implemented here.

Environment variables
---------------------
AI_TRADER_MARKET_CACHE_DIR
    Persistent cache directory. Default: <project>/data/market_cache

AI_TRADER_MARKET_CACHE_TTL_SECONDS
    Default cache lifetime: 900 seconds (15 minutes).

AI_TRADER_MARKET_INTRADAY_TTL_SECONDS
    Default intraday cache lifetime: 60 seconds.

AI_TRADER_MARKET_FORCE_REFRESH
    Set to 1/true/yes to bypass existing cache.
"""

from __future__ import annotations

import hashlib
import json
import os
import pickle
import tempfile
import time
from pathlib import Path
from typing import Any, Optional, Sequence

import pandas as pd
import yfinance as yf

VERSION = "2.0"
MODULE_NAME = "Shared Market Data Layer"

PROJECT_ROOT = Path(__file__).resolve().parents[2]
DEFAULT_CACHE_DIR = PROJECT_ROOT / "data" / "market_cache"
DEFAULT_TTL_SECONDS = 900
DEFAULT_INTRADAY_TTL_SECONDS = 60


def _env_bool(name: str, default: bool = False) -> bool:
    value = os.getenv(name)
    if value is None:
        return default
    return value.strip().lower() in {"1", "true", "yes", "on"}


def _env_int(name: str, default: int) -> int:
    try:
        return max(0, int(os.getenv(name, str(default))))
    except (TypeError, ValueError):
        return default


def normalize_ticker(ticker: str) -> str:
    return str(ticker or "").strip().upper()


def cache_directory(cache_dir: Optional[str | Path] = None) -> Path:
    root = Path(
        cache_dir
        if cache_dir is not None
        else os.getenv("AI_TRADER_MARKET_CACHE_DIR", str(DEFAULT_CACHE_DIR))
    )
    root.mkdir(parents=True, exist_ok=True)
    return root


def _ttl_seconds(interval: str, ttl_seconds: Optional[int]) -> int:
    if ttl_seconds is not None:
        return max(0, int(ttl_seconds))
    interval_text = str(interval or "1d").lower()
    if interval_text.endswith("m") or interval_text.endswith("h"):
        return _env_int(
            "AI_TRADER_MARKET_INTRADAY_TTL_SECONDS",
            DEFAULT_INTRADAY_TTL_SECONDS,
        )
    return _env_int(
        "AI_TRADER_MARKET_CACHE_TTL_SECONDS",
        DEFAULT_TTL_SECONDS,
    )


def _request_key(
    ticker: str,
    *,
    period: Optional[str],
    interval: str,
    start: Optional[str],
    end: Optional[str],
    auto_adjust: bool,
    actions: bool,
    group_by: str,
) -> str:
    payload = {
        "ticker": normalize_ticker(ticker),
        "period": period,
        "interval": interval,
        "start": start,
        "end": end,
        "auto_adjust": bool(auto_adjust),
        "actions": bool(actions),
        "group_by": group_by,
    }
    raw = json.dumps(payload, sort_keys=True, separators=(",", ":"))
    return hashlib.sha256(raw.encode("utf-8")).hexdigest()


def _cache_path(cache_dir: Path, key: str) -> Path:
    return cache_dir / f"market_{key}.pkl"


def _read_cache(path: Path, ttl_seconds: int) -> Optional[pd.DataFrame]:
    try:
        age = time.time() - path.stat().st_mtime
        if age < 0 or age > ttl_seconds:
            return None
        with path.open("rb") as handle:
            payload = pickle.load(handle)
        if not isinstance(payload, dict):
            return None
        data = payload.get("data")
        if not isinstance(data, pd.DataFrame):
            return None
        return data.copy(deep=True)
    except Exception:
        return None


def _write_cache(path: Path, data: pd.DataFrame, request: dict[str, Any]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp_name = tempfile.mkstemp(
        prefix=path.name + ".",
        suffix=".tmp",
        dir=str(path.parent),
    )
    try:
        payload = {
            "version": VERSION,
            "fetched_at": time.time(),
            "request": request,
            "data": data,
        }
        with os.fdopen(fd, "wb") as handle:
            pickle.dump(payload, handle, protocol=pickle.HIGHEST_PROTOCOL)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(tmp_name, path)
    except Exception:
        try:
            os.unlink(tmp_name)
        except OSError:
            pass


def get_history(
    ticker: str,
    *,
    period: Optional[str] = "5y",
    interval: str = "1d",
    start: Optional[str] = None,
    end: Optional[str] = None,
    auto_adjust: bool = True,
    actions: bool = False,
    group_by: str = "column",
    threads: bool = False,
    ttl_seconds: Optional[int] = None,
    force_refresh: Optional[bool] = None,
    cache_dir: Optional[str | Path] = None,
) -> pd.DataFrame:
    """Return OHLCV history using a persistent shared cache.

    The cache key includes all parameters that materially change the yfinance
    response. Therefore adjusted and unadjusted data are intentionally stored
    separately; this preserves existing engine behavior.
    """
    symbol = normalize_ticker(ticker)
    if not symbol:
        return pd.DataFrame()

    if force_refresh is None:
        force_refresh = _env_bool("AI_TRADER_MARKET_FORCE_REFRESH", False)

    # yfinance treats period and start/end as alternative request modes.
    if start is not None or end is not None:
        period_key = None
    else:
        period_key = period or "5y"

    request = {
        "ticker": symbol,
        "period": period_key,
        "interval": interval,
        "start": start,
        "end": end,
        "auto_adjust": bool(auto_adjust),
        "actions": bool(actions),
        "group_by": group_by,
    }
    key = _request_key(
        symbol,
        period=period_key,
        interval=interval,
        start=start,
        end=end,
        auto_adjust=auto_adjust,
        actions=actions,
        group_by=group_by,
    )
    path = _cache_path(cache_directory(cache_dir), key)
    ttl = _ttl_seconds(interval, ttl_seconds)

    if not force_refresh:
        cached = _read_cache(path, ttl)
        if cached is not None:
            return cached

    kwargs: dict[str, Any] = {
        "interval": interval,
        "auto_adjust": auto_adjust,
        "actions": actions,
        "progress": False,
        "group_by": group_by,
        "threads": threads,
    }
    if start is not None:
        kwargs["start"] = start
    elif period_key is not None:
        kwargs["period"] = period_key
    if end is not None:
        kwargs["end"] = end

    try:
        data = yf.download(symbol, **kwargs)
    except Exception:
        # Preserve yfinance's failure semantics for callers while avoiding a
        # stale/partial cache write.
        raise

    if data is None:
        data = pd.DataFrame()
    if not isinstance(data, pd.DataFrame):
        data = pd.DataFrame(data)

    if not data.empty:
        _write_cache(path, data, request)

    return data.copy(deep=True)


def get_daily_history(
    ticker: str,
    *,
    period: str = "5y",
    auto_adjust: bool = True,
    actions: bool = False,
    group_by: str = "column",
    ttl_seconds: Optional[int] = None,
    force_refresh: Optional[bool] = None,
    cache_dir: Optional[str | Path] = None,
) -> pd.DataFrame:
    return get_history(
        ticker,
        period=period,
        interval="1d",
        auto_adjust=auto_adjust,
        actions=actions,
        group_by=group_by,
        threads=False,
        ttl_seconds=ttl_seconds,
        force_refresh=force_refresh,
        cache_dir=cache_dir,
    )


def get_multiple_daily_history(
    tickers: Sequence[str],
    *,
    period: str = "5y",
    auto_adjust: bool = True,
    actions: bool = False,
    group_by: str = "column",
    ttl_seconds: Optional[int] = None,
    force_refresh: Optional[bool] = None,
    cache_dir: Optional[str | Path] = None,
) -> dict[str, pd.DataFrame]:
    """Fetch multiple tickers, reusing individual cache entries when present.

    Existing cached symbols are never requested from Yahoo again. Missing
    symbols are downloaded one-by-one for predictable cache semantics and to
    avoid reintroducing yfinance's multi-symbol request complexity into the
    engines.
    """
    result: dict[str, pd.DataFrame] = {}
    for ticker in tickers:
        symbol = normalize_ticker(ticker)
        if not symbol:
            continue
        result[symbol] = get_daily_history(
            symbol,
            period=period,
            auto_adjust=auto_adjust,
            actions=actions,
            group_by=group_by,
            ttl_seconds=ttl_seconds,
            force_refresh=force_refresh,
            cache_dir=cache_dir,
        )
    return result


def clear_cache(cache_dir: Optional[str | Path] = None) -> int:
    root = cache_directory(cache_dir)
    count = 0
    for path in root.glob("market_*.pkl"):
        try:
            path.unlink()
            count += 1
        except OSError:
            pass
    return count


def cache_stats(cache_dir: Optional[str | Path] = None) -> dict[str, Any]:
    root = cache_directory(cache_dir)
    files = list(root.glob("market_*.pkl"))
    return {
        "version": VERSION,
        "cache_dir": str(root),
        "files": len(files),
        "size_bytes": sum(p.stat().st_size for p in files if p.exists()),
    }


__all__ = [
    "VERSION",
    "MODULE_NAME",
    "get_history",
    "get_daily_history",
    "get_multiple_daily_history",
    "clear_cache",
    "cache_stats",
    "normalize_ticker",
]
